# Appeal Architect — environment
#
# Copy the backend block to backend/.env and the frontend block to
# frontend/.env.local. Never commit either; .gitignore covers both.
#
# Values marked REQUIRED must be set before that half of the app will start.
# Everything else has a working default for local development.

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND  →  backend/.env
# ─────────────────────────────────────────────────────────────────────────────

# Supabase. REQUIRED for auth, storage and persistence.
# Project settings → API. The service-role key bypasses RLS: server only, never
# sent to a browser, never logged.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Project settings → API → JWT Settings → JWT Secret. The backend verifies every
# bearer token against this and takes user_id from the verified claims only.
SUPABASE_JWT_SECRET=

# Anthropic. REQUIRED from phase 4 (document extraction and letter prose).
# The LLM reads documents and writes prose. It never decides a route, a deadline,
# or whether an argument holds — see docs/ARCHITECTURE.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Email. REQUIRED from phase 6 (deadline reminders).
RESEND_API_KEY=
FROM_EMAIL=

# Stripe. REQUIRED from phase 8 (billing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard (Products -> your product -> Pricing).
STRIPE_PRICE_APPEAL_PACKAGE=
STRIPE_PRICE_SUBSCRIPTION=

# Pinned engine versions. Every route determination and argument graph records
# the version that produced it, so a conclusion can always be reproduced.
RULEBASE_VERSION=1.0.0
SCHEMES_VERSION=1.0.0

# Shared secret for POST /internal/run-reminders. The scheduled job sends it in
# the X-Internal-Job-Secret header. Generate with: openssl rand -hex 32
INTERNAL_JOB_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Per-user monthly ceiling on LLM calls, enforced before the call is made.
LLM_MONTHLY_CALL_CAP=200

# development | production. Controls error verbosity and dev-only UI affordances.
ENV=development

# Where the reminder cron job finds the API. Set on the CRON service only; the
# web service does not need it.
API_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND  →  frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* is compiled into the static bundle and is public by definition.
# The anon key is safe here; RLS is what protects the data. Never put the
# service-role key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
