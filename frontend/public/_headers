# Cloudflare Pages reads this file from the root of the published directory.
# Keep it in sync with the backend's CORS list when origins change.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# No referrer at all from the pages that carry a case in the URL bar, so a
# health-related path never leaves in a Referer header.
/case/*
  Referrer-Policy: no-referrer
/cases/*
  Referrer-Policy: no-referrer
/settings/*
  Referrer-Policy: no-referrer

# Content-hashed by the build, so they can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed: a replaced asset keeps its filename, so cache for a day
# and let the CDN revalidate in the background after that.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
